root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4
tab_width = 4

# Kotlin
[*.{kt,kts}]
ij_kotlin_code_style_defaults = KOTLIN_OFFICIAL
indent_size = 4
continuation_indent_size = 4
max_line_length = 120

# Gradle
[*.properties]
indent_size = 2

# XML (layouts, manifests, resources)
[*.xml]
indent_size = 4
continuation_indent_size = 4

# Markdown
[*.md]
trim_trailing_whitespace = false
max_line_length = off