{
  "name": "flowpipe",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "android": "react-native run-android",
    "android:apk": "cd android && ./gradlew assembleRelease && cd ..",
    "android:aab": "cd android && ./gradlew bundleRelease && cd ..",
    "ios": "react-native run-ios",
    "ios:se": "yarn react-native run-ios --device \"Amnesia Amnesia’s iPhone\"",
    "ios:pro": "yarn react-native run-ios --device \"iPhone\"",
    "ios:phone": "xcrun simctl boot \"iPhone 16 Pro\" & open -a Simulator",
    "ios:table": "xcrun simctl boot \"iPad Air 11-inch (M3)\" & open -a Simulator",
    "ios:list": "xcrun simctl list devices",
    "pod:init": "bundle install",
    "pod": "cd ios && bundle exec pod install",
    "start": "react-native start",
    "start:reset": "react-native start --reset-cache",
    "start:host": "react-native start --host $(ipconfig getifaddr en0)",
    "start:rozenite": "WITH_ROZENITE=true react-native start",
    "lint": "eslint . --fix",
    "test": "jest",
    "font": "npx react-native-asset",
    "clean": "watchman watch-del-all && rm -rf node_modules ios/Pods ios/Podfile.lock ~/Library/Developer/Xcode/DerivedData && yarn cache clean",
    "rename": "npx react-native-rename@latest \"FlowPipe\" -b \"flowpipe.io\" --iosBundleID \"io.flowpipe\" --skipGitStatusCheck",
    "postinstall": "patch-package"
  },
  "dependencies": {
    "@gorhom/bottom-sheet": "^5.2.7",
    "@react-native-clipboard/clipboard": "^1.16.3",
    "@react-native-community/hooks": "^100.1.0",
    "@react-navigation/native": "^7.1.28",
    "@react-navigation/native-stack": "^7.10.1",
    "@rn-primitives/portal": "^1.3.0",
    "dayjs": "^1.11.19",
    "emittery": "^1.2.0",
    "i18next": "^25.7.1",
    "lodash": "^4.17.21",
    "react": "19.1.1",
    "react-i18next": "^16.3.5",
    "react-native": "0.82.1",
    "react-native-bootsplash": "^6.3.11",
    "react-native-edge-to-edge": "^1.7.0",
    "react-native-gesture-handler": "^2.29.1",
    "react-native-keyboard-controller": "^1.20.0",
    "react-native-localize": "^3.6.0",
    "react-native-nitro-modules": "^0.33.2",
    "react-native-reanimated": "^4.1.5",
    "react-native-safe-area-context": "^5.6.2",
    "react-native-screens": "^4.20.0",
    "react-native-svg": "^15.15.1",
    "react-native-unistyles": "^3.0.22",
    "react-native-worklets": "^0.7",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "20.0.0",
    "@react-native-community/cli-platform-android": "20.0.0",
    "@react-native-community/cli-platform-ios": "20.0.0",
    "@react-native-community/eslint-config": "^3.2.0",
    "@react-native/babel-preset": "0.82.1",
    "@react-native/eslint-config": "0.82.1",
    "@react-native/metro-config": "0.82.1",
    "@react-native/typescript-config": "0.82.1",
    "@rozenite/metro": "^1.2.0",
    "@rozenite/network-activity-plugin": "^1.2.0",
    "@rozenite/overlay-plugin": "^1.2.0",
    "@rozenite/react-navigation-plugin": "^1.2.0",
    "@types/i18next": "^13.0.0",
    "@types/jest": "^29.5.13",
    "@types/lodash": "^4.17.21",
    "@types/react": "^19.1.1",
    "@types/react-test-renderer": "^19.1.0",
    "@typescript-eslint/eslint-plugin": "^8.53.0",
    "@typescript-eslint/parser": "^8.53.0",
    "babel-plugin-module-resolver": "^5.0.2",
    "eslint": "^8.19.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-eslint-comments": "^3.2.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jest": "^29.12.1",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-promise": "^7.2.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-native": "^5.0.0",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "eslint-plugin-sort-exports": "^0.9.1",
    "eslint-plugin-unicorn": "50",
    "eslint-plugin-unused-imports": "^4.3.0",
    "jest": "^29.6.3",
    "patch-package": "^8.0.1",
    "postinstall-postinstall": "^2.1.0",
    "prettier": "^3.7.4",
    "react-native-svg-transformer": "^1.5.2",
    "react-test-renderer": "19.1.1",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "yarn@4.12.0"
}
